rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Helpers ----------------------------------------------------------
    // Only these accounts are admins. Get each UID from
    // Firebase console -> Authentication -> Users -> "User UID" column.
    function isAdmin() {
      return request.auth != null
        && request.auth.uid in ['nUtwLcOp91Npo85uq5bUCLxdxuu1', 'SeBAZCXQX7PYKslzdcOenKEu6dt2'];
    }

    function isStr(v, maxLen) {
      return v is string && v.size() <= maxLen;
    }

    // Optional string field: absent, or a string no longer than maxLen
    function optStr(data, key, maxLen) {
      return !(key in data) || isStr(data[key], maxLen);
    }

    // ---- Public catalog (read by everyone, edited by admins) --------------
    match /items/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /categories/{catId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---- Old bolis orders: kept for records, admins only, no new ones ------
    match /orders/{orderId} {
      allow read, delete: if isAdmin();
      allow create, update: if false;
    }

    // ---- Marketing contacts & consent -------------------------------------

    // Approved consent wording, by version (e.g. "v1"). Public can read it
    // so the form always shows the exact approved text.
    match /consentTexts/{version} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Sign-up form submissions. Public can only ADD one; nobody can edit it,
    // so each submission is permanent proof of what the person agreed to.
    match /signups/{signupId} {
      allow create: if validSignup(request.resource.data);
      allow read, delete: if isAdmin();   // delete only for "erase my data" requests
      allow update: if false;
    }

    // One record per person (document ID = phone like +19155551234, or the
    // email address for sign-ups without a phone).
    // Built and maintained by admins from signups, orders and manual entries.
    match /contacts/{phone} {
      allow read, write: if isAdmin();
    }

    // Every opt-in / opt-out recorded by an admin (STOP replies, in-person,
    // WhatsApp "SI"). Append-only: never edited or deleted.
    match /consentLog/{entryId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    function validSignup(d) {
      return d.keys().hasOnly([
            'name', 'phone', 'email', 'language',
            'optInTransactional', 'optInMarketing', 'consentTextVersion',
            'source', 'pageUrl', 'createdAt'])
        && d.keys().hasAll([
            'name', 'email', 'language',
            'optInTransactional', 'optInMarketing', 'consentTextVersion',
            'source', 'createdAt'])
        && isStr(d.name, 60) && d.name.size() >= 2
        && (!('phone' in d) || (d.phone is string && d.phone.matches('^[+]1[0-9]{10}$')))
        // A phone number is required only when a texting box is checked
        && ('phone' in d || (d.optInTransactional == false && d.optInMarketing == false))
        && isStr(d.email, 100) && d.email.matches('^[^@ ]+@[^@ ]+[.][^@ ]+$')
        && d.language in ['es', 'en']
        && optStr(d, 'pageUrl', 200)
        && d.optInTransactional is bool
        && d.optInMarketing is bool
        && exists(/databases/$(database)/documents/consentTexts/$(d.consentTextVersion))
        && d.source in ['website', 'bouquet_card', 'checkout', 'giveaway', 'event']
        && d.createdAt == request.time;   // must use serverTimestamp()
    }
  }
}
